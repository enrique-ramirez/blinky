# Copy to ../.env  (repo root) and fill in. The .env file is gitignored.
#
# Fine-grained personal access token.
#
#   Repository access : only the repos you list in config/repos/
#   Permissions       : Contents        -> Read-only
#                       Pull requests   -> Read and write
#                       Commit statuses -> Read-only
#                       Actions         -> Read-only
#                       Metadata        -> Read-only  (mandatory, auto-selected)
#
# Commit statuses and Actions are what let the reviewer see whether CI is green.
# The permission that covers it properly is Checks, and GitHub does not offer
# Checks on fine-grained tokens — only on GitHub Apps. Without it GitHub refuses
# the statusCheckRollup GraphQL field, so the reviewer falls back to the Actions
# and commit-status APIs; `./blinky.sh --check` says which of those your token can
# actually reach and what to put in "gates": { "ci_source": ... }. With no CI
# signal at all it skips every PR rather than guess, since a token that cannot
# see CI would otherwise approve pull requests with failing builds.
#
# Contents: Read-only is what makes it impossible for this tool to push a
# commit, create a branch, or merge. Pull requests: Read and write is the
# minimum that allows posting reviews, replying to threads, and resolving
# conversations — and is also all that is needed to read whether a pull request
# has been approved.
#
# Review requests made to a team are the one thing it cannot see: resolving a
# team takes the organisation's Members: Read, which a repository token does not
# get. A request made to you by name still counts. --check lists this as optional.
#
# Create at: https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Only set this if you point the tool at GitHub Enterprise Server.
# GITHUB_API_URL=https://github.example.com/api/v3
# GITHUB_GRAPHQL_URL=https://github.example.com/api/graphql

# Optional. Only needed on a repository whose config sets "tracker" to
# something other than GitHub issues; see config/repos.sample/. The script
# reads the ticket with these and strips them from the model's environment,
# the same as the GitHub token.
#
# ClickUp: Settings -> Apps -> API Token. Personal, read access to the tasks
# your pull requests reference is all it is used for.
# CLICKUP_TOKEN=pk_xxxxxxxxxxxxxxxxxxxxxxxx
#
# Jira Cloud: an API token from https://id.atlassian.com/manage-profile/security/api-tokens
# together with the email of the account that created it. Jira Server and
# Data Center: a personal access token on its own, no email.
# JIRA_TOKEN=xxxxxxxxxxxxxxxx
# JIRA_EMAIL=you@example.com
